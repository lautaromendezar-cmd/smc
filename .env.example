# Sanity (públicas: van al navegador)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# URL pública del sitio, sin barra final (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://smconstrucciones.com.ar

# "true" mientras sea una vista previa: noindex + robots.txt bloqueado
NEXT_PUBLIC_SITE_NOINDEX=true

# Secreto compartido con el webhook de Sanity (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# Solo para `npm run seed`, en .env.local. NUNCA cargarlo en Vercel.
SANITY_API_WRITE_TOKEN=
